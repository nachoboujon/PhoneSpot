# Copia este archivo como .env para desarrollo local. Nunca publiques valores reales.
NODE_ENV=development
SUPABASE_URL=
SUPABASE_KEY=
JWT_SECRET=
# Dominio público canónico usado para enlaces de verificación y recuperación.
PUBLIC_APP_URL=http://localhost:3000
# Duración de la sesión emitida por el servidor. En producción se recomienda 1d.
JWT_EXPIRES_IN=1d
# ID de cliente web creado en Google Cloud Console (no es un secreto).
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
# Activar después de aplicar la migración y validar el proveedor de correo.
CART_REMINDERS_ENABLED=false
CART_REMINDER_LEAD_MINUTES=60
# Opcional: secreto aleatorio de al menos 32 caracteres para un scheduler externo.
CART_REMINDER_CRON_SECRET=
EMAIL_FROM="PhoneSpot <ventas@tu-dominio.com>"
# Alternativa a Resend: SMTP (por ejemplo, Brevo). Configura uno de los dos.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
# Correo que recibe cada pedido. Si se omite, se usa ADMIN_EMAIL.
ORDER_NOTIFICATION_EMAIL=
# Cotización usada en el servidor para convertir costos de envío a USD.
DOLLAR_RATE=1400
# Solo hace falta si el frontend se sirve desde otro dominio.
CORS_ORIGINS=
